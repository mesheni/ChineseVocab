<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ChineseVocab.Views"
             x:Class="ChineseVocab.Views.CharacterDetailPage"
             Title="Детали иероглифа"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="600"
                             HorizontalOptions="Center">

            <!-- Иероглиф -->
            <Frame Padding="24" CornerRadius="12" BackgroundColor="{StaticResource Surface}"
                   HasShadow="True" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label x:Name="CharacterLabel"
                           FontSize="72" FontFamily="Microsoft YaHei"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Button x:Name="SpeakButton"
                            Text="🔊 Озвучить"
                            Clicked="OnSpeakClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="14"
                            HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Пиньинь -->
            <Frame Padding="16" CornerRadius="10" BackgroundColor="{StaticResource Surface}" HasShadow="True">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Пиньинь" FontSize="13" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
                    <Label x:Name="PinyinLabel" FontSize="22" TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Перевод -->
            <Frame Padding="16" CornerRadius="10" BackgroundColor="{StaticResource Surface}" HasShadow="True">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Перевод" FontSize="13" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
                    <Label x:Name="DefinitionLabel" FontSize="18" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Тип иероглифа -->
            <Frame Padding="16" CornerRadius="10" BackgroundColor="{StaticResource Surface}" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Тип иероглифа" FontSize="13" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Frame Grid.Column="0" Padding="12,6" CornerRadius="16"
                               x:Name="TypeBadge" HasShadow="False">
                            <Label x:Name="TypeIconLabel" FontSize="20" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="TypeNameLabel" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="TypeChineseLabel" FontSize="13" TextColor="{StaticResource Secondary}"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="TypeDescriptionLabel" FontSize="13" LineBreakMode="WordWrap"
                           TextColor="{StaticResource Secondary}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Информация -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- HSK уровень -->
                <Frame Grid.Row="0" Grid.Column="0" Padding="14" CornerRadius="10"
                       BackgroundColor="{StaticResource Surface}" HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="HSK" FontSize="12" TextColor="{StaticResource Secondary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="HskLabel" FontSize="28" FontAttributes="Bold"
                               HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Количество черт -->
                <Frame Grid.Row="0" Grid.Column="1" Padding="14" CornerRadius="10"
                       BackgroundColor="{StaticResource Surface}" HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Черт" FontSize="12" TextColor="{StaticResource Secondary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="StrokeCountLabel" FontSize="28" FontAttributes="Bold"
                               HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Радикал -->
                <Frame Grid.Row="1" Grid.Column="0" Padding="14" CornerRadius="10"
                       BackgroundColor="{StaticResource Surface}" HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Радикал" FontSize="12" TextColor="{StaticResource Secondary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="RadicalLabel" FontSize="28" FontFamily="Microsoft YaHei"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Частота -->
                <Frame Grid.Row="1" Grid.Column="1" Padding="14" CornerRadius="10"
                       BackgroundColor="{StaticResource Surface}" HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Частота" FontSize="12" TextColor="{StaticResource Secondary}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="FrequencyLabel" FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Компоненты -->
            <Frame Padding="16" CornerRadius="10" BackgroundColor="{StaticResource Surface}"
                   HasShadow="True" x:Name="ComponentsFrame" IsVisible="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Компоненты" FontSize="13" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
                    <Label x:Name="ComponentsLabel" FontSize="16" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Кнопки действий -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="✏️ Порядок черт"
                        x:Name="StrokeOrderButton"
                        Clicked="OnStrokeOrderClicked"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White" CornerRadius="10"
                        HeightRequest="48" FontSize="14"/>

                <Button Grid.Column="1"
                        Text="📝 Примеры"
                        x:Name="ExamplesButton"
                        Clicked="OnExamplesClicked"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White" CornerRadius="10"
                        HeightRequest="48" FontSize="14"/>
            </Grid>

            <!-- Заметки -->
            <Frame Padding="16" CornerRadius="10" BackgroundColor="{StaticResource Surface}"
                   HasShadow="True" x:Name="NotesFrame" IsVisible="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Заметки" FontSize="13" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
                    <Label x:Name="NotesLabel" FontSize="14" LineBreakMode="WordWrap"
                           TextColor="{StaticResource Secondary}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
